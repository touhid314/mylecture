# API KEYS
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# lecutre-agent
AGENT_MODEL="gemini-3.5-flash"
LOG_FULL_LLM_PROMPT="False"

# tts
OPENAI_TTS_MODEL="gpt-4o-mini-tts-2025-12-15" # OpenAI TTS model id
OPENAI_TTS_VOICE="cedar" # alloy ash ballad coral cedar echo fable marin nova onyx sage shimmer verse
GOOGLE_TTS_MODEL="gemini-3.1-flash-tts-preview" # gemini-3-flash-preview-tts gemini-3-flash-lite-preview-tts gemini-3-pro-tts gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE="Vindemiatrix" # Google prebuilt voice name
KOKORO_MODEL="onnx-community/Kokoro-82M-ONNX" # any kokoro-js/Hugging Face compatible model id
KOKORO_DEFAULT_VOICE="am_puck" # af_heart af_alloy af_aoede af_bella af_jessica af_kore af_nicole af_nova af_river af_sarah af_sky am_adam am_echo am_eric am_fenrir am_liam am_michael am_onyx am_puck am_santa bf_emma bf_isabella bf_alice bf_lily bm_george bm_lewis bm_daniel bm_fable
KOKORO_ENGINE="onnxruntime" # onnxruntime onnx ort cuda kokoro-js node js
KOKORO_DEVICE="cuda" # cuda cpu
KOKORO_STRICT_GPU="true" # true false
KOKORO_DTYPE="fp32" # fp32 q8
KOKORO_PHONEMIZER="js" # misaki python js node phonemizer
KOKORO_ONNX_MODEL="model.onnx" # model.onnx
KOKORO_ONNX_MODEL_DIR="models/kokoro-onnx" # local Kokoro ONNX asset directory
KOKORO_CHUNK_WORKERS="1" # positive integer
KOKORO_CPU_FALLBACK_DTYPE="q8" # q8 fp32

# render
RENDER_MAX_PARALLEL="1" # positive integer

# logging
LOG_LEVEL = "ERROR"

# ffmpeg
FFMPEG_PATH = "" # Path to ffmpeg.exe if not in PATH
FFPROBE_PATH = "" # Path to ffprobe.exe if not in PATH
