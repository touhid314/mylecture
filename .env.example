# Agent API Configuration
# MYLECTURE_AGENT_API_URL="http://127.0.0.1:4310" # Optional override url
MYLECTURE_AGENT_API_TOKEN=""                    # Optional API bearer token

# IDE Configuration
AGENT_MODEL="gemini-3.5-flash"                  # Fallback model name for the agent
RENDER_MAX_PARALLEL="1"                         # Max parallel render jobs
LOG_LEVEL="ERROR"                               # Logging verbosity (ERROR, WARN, INFO, DEBUG)

# TTS (OpenAI + Gemini). Pick a voice from those groups in the IDE Resolve/Render menus.
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL="gpt-4o-mini-tts-2025-12-15"
# OPENAI_TTS_VOICE="cedar"
# GOOGLE_API_KEY=
# GOOGLE_TTS_MODEL="gemini-3.1-flash-tts-preview"
# GOOGLE_TTS_VOICE="Vindemiatrix"

# FFmpeg Paths
FFMPEG_PATH=""                                  # Custom absolute path to ffmpeg executable (leave blank if in system PATH)
FFPROBE_PATH=""                                 # Custom absolute path to ffprobe executable (leave blank if in system PATH)
