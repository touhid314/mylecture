# API KEYS
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ELEVENLABS_API_KEY=""
GEMINI_MAX_TOKENS=65,536

# lecutre-agent
AGENT_MODEL="gemini-3.5-flash"
# Optional LectureGen stage overrides (fall back to AGENT_MODEL / --model):
# SCRIPT_MODEL="gpt-5.6-luna"       # answer + script writer
# ANIMATOR_MODEL="gemini-3.5-flash" # animator, iagen, gamegen
GPT_REASONING_EFFORT="none" # OpenAI only; unset also defaults to none (Gemini 3.5 Flash parity). Values: none minimal low medium high xhigh max
# GPT_SERVICE_TIER="fast" # OpenAI only; omit when unset. Separate from GPT_REASONING_EFFORT. Recommended: fast (priority is a backwards-compatible alias)
LOG_FULL_LLM_PROMPT="True"
GETIMG_MODEL="gemini-flash-lite"
GETIMG_WATCHMAN_MODEL="gemini-2.5-flash"
SCRIPT_TRIMMER_CHUNK_SIZE=75 # PER CHUNK MAX NUMBER OF NARRATION WORDS; THE ANIMATOR ANIMATES ONE CHUNK AT A TIME
ANIMATOR_MAX_PREVIOUS_HTMLS=4 # NUMBER OF PREVIOUS GENERATED HTML FILES TO KEEP IN ANIMATOR CONTEXT (2 = LAST 2, 0 = NONE, 999999=keep all previous)

# tts
OPENAI_TTS_MODEL="gpt-4o-mini-tts-2025-12-15" # OpenAI TTS model id
OPENAI_TTS_VOICE="cedar" # alloy ash ballad coral cedar echo fable marin nova onyx sage shimmer verse
GOOGLE_TTS_MODEL="gemini-2.5-flash-preview-tts" # gemini-3-flash-preview-tts gemini-3-flash-lite-preview-tts gemini-3-pro-tts gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE="Vindemiatrix" # Google prebuilt voice name
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5" # Required ElevenLabs TTS model id; no fallback
KOKORO_MODEL="onnx-community/Kokoro-82M-ONNX" # any kokoro-js/Hugging Face compatible model id
KOKORO_DEFAULT_VOICE="am_puck" # af_heart af_alloy af_aoede af_bella af_jessica af_kore af_nicole af_nova af_river af_sarah af_sky am_adam am_echo am_eric am_fenrir am_liam am_michael am_onyx am_puck am_santa bf_emma bf_isabella bf_alice bf_lily bm_george bm_lewis bm_daniel bm_fable
KOKORO_ENGINE="onnxruntime" # onnxruntime onnx ort cuda kokoro-js node js
KOKORO_DEVICE="cuda" # cuda cpu
KOKORO_STRICT_GPU="false" # true false
KOKORO_DTYPE="fp32" # fp32 q8
KOKORO_PHONEMIZER="js" # misaki python js node phonemizer
KOKORO_ONNX_MODEL="model.onnx" # model.onnx
KOKORO_ONNX_MODEL_DIR="models/kokoro-onnx" # local Kokoro ONNX asset directory
KOKORO_CHUNK_WORKERS="1" # positive integer
KOKORO_CPU_FALLBACK_DTYPE="q8" # q8 fp32

# ide
RENDER_MAX_PARALLEL="1" # positive integer

# logging
LOG_LEVEL = "ERROR"

# ffmpeg
FFMPEG_PATH = "" # Path to ffmpeg.exe if not in PATH
FFPROBE_PATH = "" # Path to ffprobe.exe if not in PATH
