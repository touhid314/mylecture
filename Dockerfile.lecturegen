# LectureGen API image. The render worker remains a separate service built
# from the root Dockerfile.
FROM node:22-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3 \
    python3-pip \
    python-is-python3 \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages python-dotenv

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci

COPY . .

RUN groupadd --system lecturegen \
    && useradd --system --gid lecturegen --home-dir /app lecturegen \
    && chown -R lecturegen:lecturegen /app

USER lecturegen

ENV NODE_ENV=production
ENV PORT=8790
EXPOSE 8790

CMD ["npm", "run", "lecturegen:server"]

