# VPS render worker — copy to /opt/mylecture/.env (or .env.worker) and fill in values.
# STORAGE_BACKEND must match Vercel (mylecture-website). See RENDER_WORKER.md.

NODE_ENV=production
PORT=8787

# --- Storage (must match website) ---
STORAGE_BACKEND=r2-only
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=mylecture-private

# Supabase storage (only if STORAGE_BACKEND=supabase or r2 dual mode)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_VIDEO_BUCKET=videos

# --- Postgres queue (session pooler :5432, NOT transaction pooler 6543) ---
DATABASE_URL=postgresql://...@...pooler.supabase.com:5432/postgres

# --- Website integration ---
WEBSITE_CALLBACK_URL=https://mylecture.ai/api/video-agent/callback
# LECTUREGEN_CALLBACK_URL=https://mylecture.ai/api/video-agent/lecturegen-callback  # LectureGen host only; optional explicit override
RENDER_CALLBACK_TOKEN=
RENDER_WORKER_TOKEN=

# --- LectureGen (when website uses pipelineVersion=lecturegen) ---
# LECTUREGEN_URL=https://lecturegen.internal:8790
# LECTUREGEN_WORKER_TOKEN=

# --- Worker tuning (2-core VPS) ---
RENDER_WORKER_MAX_CONCURRENCY=1
KOKORO_DEVICE=cpu
KOKORO_CHUNK_WORKERS=1

# Queue poller only — do NOT set RENDER_HTTP_JOBS=1 when DATABASE_URL is set
# RENDER_HTTP_JOBS=

# Optional cloud TTS (faster than Kokoro CPU; API cost).
# Only the active provider's variables are required — tts.py loads them lazily.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE=bIHbv24MWmeRgasZH58o
# ELEVENLABS_STABILITY=0.7
# ELEVENLABS_SIMILARITY_BOOST=0.75

# LLM keys forwarded to child processes when needed
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
