{
  "name": "mylecture",
  "productName": "MyLecture",
  "version": "2.0.2",
  "description": "MyLecture — an AI studio for narrated, animated videos: lessons, explainers, product demos, stories and more.",
  "main": "electron/main.js",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "author": "MyLecture contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pretest": "node node_modules/electron/install.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "predist": "node scripts/fetch-hermes.mjs",
    "dist": "electron-builder --publish never",
    "predist:win": "node scripts/fetch-hermes.mjs",
    "dist:win": "electron-builder --win --x64 --publish never",
    "predist:mac": "node scripts/fetch-hermes.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "smoke": "node scripts/smoke-packaged.mjs",
    "release:publish": "node scripts/publish-update.mjs",
    "server:configure": "node scripts/configure-server.mjs",
    "release:build": "npm test && npm run dist:win && node scripts/smoke-packaged.mjs --deep",
    "hermes:bundle": "node scripts/fetch-hermes.mjs"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "kokoro-js": "^1.2.1",
    "markdown-it": "^14.3.3",
    "monaco-editor": "^0.52.2",
    "unpdf": "^2.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "ai.mylecture.app",
    "productName": "MyLecture",
    "artifactName": "MyLecture-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/.cache/**",
      "!node_modules/@huggingface/transformers/{src,types}/**",
      "!node_modules/@huggingface/transformers/dist/*.{wasm,jsep.mjs}",
      "!node_modules/@huggingface/transformers/dist/transformers{,.min,.web,.web.min}.js",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/monaco-editor/**",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*",
      "!node_modules/**/*.d.ts"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/hermes",
        "to": "hermes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "app/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**"
      ]
    },
    "portable": {
      "artifactName": "MyLecture-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "files": [
        "app/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}/**"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MyLecture uses the microphone when you talk to your tutor in Study and when you record a voice to clone. Speech is transcribed on this Mac."
      }
    },
    "dmg": {
      "artifactName": "MyLecture-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://mylecture-server.touhid3-1416.workers.dev/updates"
      }
    ]
  }
}
