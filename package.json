{
  "name": "mylecture-renderer",
  "version": "1.0.0",
  "description": "General HTML-to-video renderer with synchronized audio support.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "agent": "tsx packages/lecture-agent/src/cli.ts",
    "chat": "tsx packages/lecture-agent/src/cli.ts --chat",
    "build:plan": "node --import tsx src/build-plan.ts",
    "render:video": "node --import tsx src/render-video.ts",
    "subtitle:burn": "node --import tsx src/subtitle-burner.ts",
    "build:viewer": "npm --prefix packages/lecture-viewer run build",
    "version:sync": "node --import tsx src/sync-versions.ts",
    "ide": "npm run version:sync && npm run build:viewer && node --import tsx src/ide-server.ts",
    "coursegen": "node --import tsx src/coursegen/cli.ts",
    "coursegen:ui": "node --import tsx src/coursegen/server.ts",
    "adaptive:ui": "node --import tsx src/coursegen/adaptive-server.ts",
    "test": "npm run test:coursegen && npm run test:build && npm run test:render && npm run test:visual && npm run test:narration",
    "test:build": "node --import tsx src/build-plan.ts --input tests/fixtures/input-contract-test/index.html --out .render/tests/input-contract-resolved.html",
    "test:render": "node --import tsx src/render-video.ts --html tests/fixtures/input-contract-test/index.html --resolved-html .render/tests/input-contract-render-resolved.html --out .render/tests/input-contract-smoke.mp4 --max-frames 5 --skip-video",
    "test:visual": "node --import tsx src/render-video.ts --html tests/fixtures/visual-only-3d-test/index.html --resolved-html .render/tests/visual-3d-resolved.html --out .render/tests/visual-3d-smoke.mp4 --max-frames 5 --skip-video",
    "test:narration": "node --import tsx src/render-video.ts --html tests/fixtures/input-contract-test/index.html --resolved-html .render/tests/visual-narration-resolved.html --out .render/tests/visual-narration-480p15.mp4 --width 854 --height 480 --fps 15",
    "test:coursegen": "node --import tsx --test src/coursegen/skill-graph.test.ts src/coursegen/interaction-qa.test.ts src/coursegen/review-notes.test.ts src/coursegen/practice-repair-context.test.ts src/coursegen/review-practice.test.ts src/coursegen/shell-qa.test.ts src/coursegen/shell-qa-hud.test.ts src/coursegen/layout-overlap.test.ts src/coursegen/video-frame-qa.test.ts src/coursegen/spawn.test.ts src/coursegen/challenge-pacing.test.ts src/coursegen/activity-shell/assemble.test.ts src/coursegen/activity-shell/stage-scaffold.test.ts src/coursegen/activity-shell/shell-e2e.test.ts",
    "benchmark:1080p": "node --import tsx src/render-video.ts --html tests/fixtures/input-contract-test/index.html --resolved-html .render/benchmarks/1080p-resolved.html --out .render/benchmarks/1080p-30fps.mp4 --width 1920 --height 1080 --fps 30 --max-frames 300",
    "benchmark:480p": "npm run test:narration",
    "render:contract-test": "node --import tsx src/render-video.ts --html tests/fixtures/input-contract-test/index.html --out tests/fixtures/input-contract-test/rendered.mp4",
    "render:sync-4k-test": "node --import tsx src/render-video.ts --html tests/fixtures/input-contract-4k-sync-test/index.html --out tests/fixtures/input-contract-4k-sync-test/rendered-4k-60fps.mp4 --width 3840 --height 2160 --fps 60",
    "render:visual-3d": "node --import tsx src/render-video.ts --html tests/fixtures/visual-only-3d-test/index.html --out tests/fixtures/visual-only-3d-test/rendered-1080p-60fps.mp4 --width 1920 --height 1080 --fps 60",
    "build:fixture": "node --import tsx src/build-plan.ts --input tests/fixtures/plan-pipeline/source.html --out tests/fixtures/plan-pipeline/index.html",
    "render:fixture": "node --import tsx src/render-video.ts --html tests/fixtures/plan-pipeline/source.html --out tests/fixtures/plan-pipeline/rendered.mp4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "^1.57.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "three": "^0.184.0"
  }
}
