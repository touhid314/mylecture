{
  "name": "mylecture",
  "productName": "MyLecture",
  "version": "0.1.0",
  "description": "MyLecture — an open-source study app that answers every question with a narrated, animated video lesson.",
  "main": "electron/main.js",
  "type": "module",
  "license": "MIT",
  "author": "MyLecture contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "ffmpeg-static": "^5.3.0",
    "katex": "^0.19.1",
    "kokoro-js": "^1.2.1",
    "markdown-it": "^14.3.3",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "ai.mylecture.app",
    "productName": "MyLecture",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ]
  }
}
