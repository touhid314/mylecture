{
  "name": "mylecture",
  "productName": "MyLecture",
  "version": "0.1.0",
  "description": "MyLecture \u2014 an open-source study app that answers every question with a narrated, animated video lesson.",
  "main": "electron/main.js",
  "type": "module",
  "license": "MIT",
  "author": "MyLecture contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "ffmpeg-static": "^5.3.0",
    "katex": "^0.19.1",
    "kokoro-js": "^1.2.1",
    "markdown-it": "^14.3.3",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "ai.mylecture.app",
    "productName": "MyLecture",
    "artifactName": "MyLecture-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/.cache/**",
      "!node_modules/@huggingface/transformers/{src,types}/**",
      "!node_modules/@huggingface/transformers/dist/*.{wasm,jsep.mjs}",
      "!node_modules/@huggingface/transformers/dist/transformers{,.min,.web,.web.min}.js",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/monaco-editor/**",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*",
      "!node_modules/**/*.d.ts"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**"
      ]
    },
    "portable": {
      "artifactName": "MyLecture-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}/**"
      ]
    },
    "dmg": {
      "artifactName": "MyLecture-${version}-mac-${arch}.${ext}"
    }
  }
}
