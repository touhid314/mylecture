{
  "name": "mylecture-renderer",
  "version": "1.0.0",
  "description": "General HTML-to-video renderer with synchronized audio support.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "agent": "tsx ../mylecture-agent/src/editor-agent/cli.ts",
    "editor-agent": "tsx ../mylecture-agent/src/editor-agent/cli.ts",
    "lecturegen": "tsx ../mylecture-agent/src/lecturegen.ts",
    "prompt-builder": "tsx ../mylecture-agent/src/prompt_builder.ts",
    "chat": "tsx ../mylecture-agent/src/editor-agent/cli.ts --chat",
    "token-tracker": "tsx ../mylecture-agent/src/token-tracker/token_tracker_dashboard.ts",
    "build:viewer": "npm --prefix packages/lecture-viewer run build",
    "version:sync": "node --import tsx src/sync-versions.ts",
    "rename:gens": "node --import tsx src/rename-gens.ts",
    "ide": "npm run version:sync && npm run build:viewer && node --import tsx src/ide-server.ts",
    "lecturegen:server": "node --import tsx src/lecturegen-server.ts",
    "coursegen": "node --import tsx src/coursegen/cli.ts",
    "coursegen:ui": "node --import tsx src/coursegen/server.ts",
    "test": "npm run test:multipart",
    "test:lecturegen": "node --import tsx --test src/utils/safe-tar-extract.test.ts src/lecturegen/*.test.ts",
    "test:tts-normalize": "node --import tsx --test src/tts-normalize.test.ts",
    "test:invoke-render": "node --import tsx src/invoke-render-section.test.ts",
    "test:elevenlabs-context": "node --import tsx src/elevenlabs-context.test.ts",
    "test:visual-edit-protect": "node --import tsx src/visual-edit-protect.test.ts",
    "test:multipart": "node --import tsx tests/render-multipart.test.ts",
    "test:coursegen": "node --import tsx --test src/coursegen/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.57.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@supabase/supabase-js": "^2.108.2",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
